# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=

# Check current model IDs and free-tier limits in Google AI Studio before running.
MODEL_FAST=gemini-3.5-flash-lite
MODEL_STRONG=gemini-3.5-flash-lite
# Used only if the main model stays overloaded (503) after retries. Leave empty to disable.
MODEL_FALLBACK=gemini-3.1-flash-lite

# Pause between model calls, to stay inside free-tier rate limits.
CALL_DELAY_S=1.0

# Web search for the Researcher.
#   web    = keyless search agent (Bing, Google, Yahoo, DuckDuckGo in turn; Gemini judges pages). Default.
#   gemini = Google Search grounding; needs a Gemini key with search quota (paid tier).
SEARCH_PROVIDER=web
# Order of the free search engines to try (each refuses automated queries some of the time).
# SEARCH_BACKENDS=bing,google,yahoo,duckduckgo
# Set SEARCH=off to skip research entirely.
SEARCH=on
