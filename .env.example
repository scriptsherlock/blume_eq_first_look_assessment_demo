# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=

# Check current model IDs and free-tier limits in Google AI Studio before running.
MODEL_FAST=gemini-3.5-flash-lite
MODEL_STRONG=gemini-3.5-flash-lite
# Used only if the main model stays overloaded (503) after retries. Leave empty to disable.
MODEL_FALLBACK=gemini-3.1-flash-lite

# Pause between model calls, to stay inside free-tier rate limits.
CALL_DELAY_S=1.0

# Google Search grounding for the Researcher. Free keys often have no search quota;
# the app detects that and carries on without independent evidence. Set off to skip the attempt.
SEARCH=on
